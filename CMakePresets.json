{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address -fuse-ld=mold",
                "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=mold",
                "TQSDK_ENABLE_CTP": "ON",
                "TQSDK_BUILD_EXAMPLES": "ON",
                "TQSDK_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "package",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-package",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_CXX_COMPILER": "clang++",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_HOST_TRIPLET": "x64-linux",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold",
                "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=mold",
                "TQSDK_ENABLE_CTP": "ON",
                "TQSDK_BUILD_EXAMPLES": "OFF",
                "TQSDK_BUILD_TESTS": "OFF"
            }
        },
        {
            "name": "ui-dev",
            "binaryDir": "${sourceDir}/build-ui",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold",
                "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=mold",
                "TQSDK_ENABLE_CTP": "ON",
                "TQSDK_BUILD_EXAMPLES": "OFF",
                "TQSDK_BUILD_TESTS": "ON",
                "TQSDK_BUILD_UI": "ON"
            },
            "generator": "Ninja"
        },
        {
            "name": "ui-package",
            "inherits": "package",
            "binaryDir": "${sourceDir}/build-ui-package",
            "cacheVariables": {
                "TQSDK_BUILD_UI": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ui-dev",
            "configurePreset": "ui-dev",
            "targets": [
                "tqsdk-ui"
            ]
        }
    ],
    "packagePresets": [
        {
            "name": "ui-package",
            "configurePreset": "ui-package",
            "generators": [
                "TGZ"
            ]
        }
    ]
}
