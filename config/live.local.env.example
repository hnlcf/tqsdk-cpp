# Tq 行情 + CTP 交易本地开发配置
# 复制为 config/live.local.env 后填写，不要提交真实账号。
#
#   cp config/live.local.env.example config/live.local.env
#   chmod 600 config/live.local.env

# gw IPC 和 node HTTP 端口
GW_PORT=14330
HTTP_PORT=18081

# Tq 免费行情
TQ_MD_HOST=free-openmd.shinnytech.com
TQ_MD_PORT=443
TQ_MD_PATH=/t/md/front/mobile

# TQ OTG 交易网关的完整示例见 config/shared/tq.toml 和 config/gw.toml；
# run_live.sh 默认生成 CTP TD 配置，TQ TD 请使用目录式配置或自行扩展环境变量。

# CTP 柜台
CTP_BROKER_ID=9999
CTP_USER_ID=your_user
CTP_PASSWORD=your_password
CTP_AUTH_CODE=0000000000000000
CTP_APP_ID=simnow_client_test
CTP_TD_FRONT=tcp://182.254.243.31:30001
CTP_MD_FRONT=tcp://182.254.243.31:30012

# 快期账户（可选；用于下载 openmd 合约目录/认证接口）
TQ_AUTH_ENABLED=0
TQ_AUTH_USER=your_tq_user
TQ_AUTH_PASSWORD=your_tq_password
TQ_AUTH_URL=https://auth.shinnytech.com

# node 预订阅；逗号分隔
SYMBOLS=SHFE.rb2701

# 合约目录文件；默认使用仓库根目录的 symbol.json
# INSTRUMENTS_FILE=/absolute/path/to/symbol.json

# 可选：日志级别
TQSDK_LOG_LEVEL=debug

# Optional REST/WS auth token (export before starting node).
TQSDK_SERVE_TOKEN=
