{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TQSDK Terminal",
  "version": "0.1.0",
  "identifier": "com.tqsdk.terminal",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TQSDK Terminal",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
