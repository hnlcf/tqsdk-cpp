{
  "name": "tqsdk-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @tqsdk/web run dev",
    "build": "npm --workspace @tqsdk/web run build",
    "preview": "npm --workspace @tqsdk/web run preview",
    "typecheck": "npm --workspace @tqsdk/web run typecheck"
  }
}
