@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost CONFIG COMPONENTS asio beast)
find_dependency(OpenSSL CONFIG)
find_dependency(magic_enum CONFIG)
find_dependency(nlohmann_json CONFIG)
find_dependency(tomlplusplus CONFIG)
find_dependency(spdlog CONFIG)
find_dependency(CLI11 CONFIG)
find_dependency(Threads)

set(tqsdk_PACKAGE_NAME "@TQSDK_PACKAGE_NAME@")
set(tqsdk_PACKAGE_SLUG "@TQSDK_PACKAGE_SLUG@")
set(tqsdk_PACKAGE_VERSION "@PROJECT_VERSION@")

include("${CMAKE_CURRENT_LIST_DIR}/tqsdkTargets.cmake")
check_required_components(tqsdk)
